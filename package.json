{
  "name": "toddler-puzzle",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run budget",
    "budget": "node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "probe": "node scripts/probe.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "art": "node scripts/preview.mjs",
    "art:check": "node scripts/check-art.mjs",
    "art:slices": "node scripts/slice-recipes.mjs",
    "audio": "node scripts/check-audio.mjs --sheet",
    "audio:check": "node scripts/check-audio.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "shot": "node scripts/shot.mjs",
    "shot:sheet": "node scripts/shot-sheet.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
